body
  background #eef2f3
  color #334155

.header-inner, .site-brand-container
  background #24454e

.site-title
  font-weight 650
  letter-spacing .08em

.site-subtitle
  color #cfdfdf
  font-size 12px

.main-inner
  padding-top 20px

.post-block, .sidebar-inner, .header-inner
  border-radius 8px
  box-shadow 0 3px 14px rgba(36, 69, 78, .05)

.post-title
  font-size 25px
  line-height 1.55
  font-weight 600

.post-title-link
  color #24454e

.post-body
  font-size 16px
  line-height 1.95
  overflow-wrap anywhere

.post-body h2
  margin-top 2em
  border-bottom 1px solid #e5eded
  padding-bottom .35em

.post-body h3
  color #2e6f76

.post-body blockquote
  background #f4f8f8
  border-left 3px solid #6faaa6
  padding 12px 18px
  color #516675

.post-body table
  font-size 14px

.post-body table th
  background #eaf1f1

.post-body mjx-container[display="true"]
  display block
  overflow-x auto
  overflow-y hidden
  padding 8px 0

.post-body mjx-container svg
  max-width none

.post-body pre
  overflow-wrap normal

.post-body .mermaid
  overflow-x auto

.post-meta
  font-size 12px
  color #7b8796

.btn
  border-radius 5px
  border-color #2e6f76
  color #2e6f76

.btn:hover
  background #2e6f76
  border-color #2e6f76
  color white

@media (max-width: 767px)
  .main-inner
    padding-top 0
  .post-title
    font-size 21px
  .post-body
    font-size 15px
