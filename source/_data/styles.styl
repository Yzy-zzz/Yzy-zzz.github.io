body
  background #eef2f3
  color #334155

.header-inner, .site-brand-container
  background #24454e

.site-title
  font-weight 650
  letter-spacing .08em

.site-subtitle
  color #cfdfdf
  font-size 12px

.main-inner
  padding-top 20px

.post-block, .sidebar-inner, .header-inner
  border-radius 8px
  box-shadow 0 3px 14px rgba(36, 69, 78, .05)

.post-title
  font-size 25px
  line-height 1.55
  font-weight 600

.post-title-link
  color #24454e

.post-body
  font-size 16px
  line-height 1.95
  overflow-wrap anywhere

.post-body h2
  margin-top 2em
  border-bottom 1px solid #e5eded
  padding-bottom .35em

.post-body h3
  color #2e6f76

.post-body blockquote
  background #f4f8f8
  border-left 3px solid #6faaa6
  padding 12px 18px
  color #516675

.post-body table
  font-size 14px

.post-body table th
  background #eaf1f1

.post-body mjx-container[display="true"]
  display block
  overflow-x auto
  overflow-y hidden
  padding 8px 0

.post-body mjx-container svg
  max-width none

.post-body pre
  overflow-wrap normal

.post-body .mermaid
  overflow-x auto

.post-meta
  font-size 12px
  color #7b8796

.btn
  border-radius 5px
  border-color #2e6f76
  color #2e6f76

.btn:hover
  background #2e6f76
  border-color #2e6f76
  color white

.topic-nav
  padding 16px 20px
  border-top 1px solid #e5eded
  text-align left

.topic-nav-title
  color #7b8796
  font-size 12px
  margin-bottom 8px

.topic-nav a
  display flex
  align-items center
  justify-content space-between
  gap 8px
  padding 5px 8px
  margin 2px 0
  border-bottom 0
  border-radius 5px
  color #24454e
  font-size 13px

.topic-nav a:hover, .topic-nav a:focus-visible
  background #eaf1f1
  color #2e6f76

.topic-nav-count
  padding 0 7px
  border-radius 10px
  background #eaf1f1
  font-size 11px

.topic-nav .topic-nav-all
  margin-top 10px
  color #64748b
  font-size 12px

.category-all-page .category-all-title
  margin-bottom 24px
  color #64748b

.category-all-page > .category-all > .category-list
  padding-left 0
  list-style none

.category-all-page > .category-all > .category-list > .category-list-item
  margin 18px 0
  padding 16px 20px
  background #f4f8f8
  border 1px solid #e5eded
  border-radius 8px

.category-all-page > .category-all > .category-list > .category-list-item > .category-list-link
  color #24454e
  font-weight 600

.category-all-page .category-list-child
  margin-top 10px

.category-all-page .category-list-count
  color #7b8796

@media (max-width: 767px)
  .main-inner
    padding-top 0
  .post-title
    font-size 21px
  .post-body
    font-size 15px
